# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
# ...and any copy of one. `.env*.local` does not match `.env.local.bak`,
# so a stray backup would otherwise show up as an untracked secrets file.
.env*.local.*
.env.local.bak

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# debug scripts
_dbg.mjs
_dbg2.mjs
_exceltest.mjs
