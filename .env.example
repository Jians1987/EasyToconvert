# NVIDIA API Keys for AI features
# Get your API keys from: https://build.nvidia.com/
# These are required for the AI-powered OCR and document summarization features.

# Nemotron OCR v2 - Used for high-accuracy text extraction from images and scanned PDFs
NVIDIA_NEMOTRON_KEY=your_nemotron_api_key_here

# DeepSeek - Used for AI document summarization, code explanation, and translation
NVIDIA_DEEPSEEK_KEY=your_deepseek_api_key_here
