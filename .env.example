# Server-only credentials. Never prefix these with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# AI productivity tools (PDF Summarizer, Code Explainer, Document Translator).
# At least ONE chat provider key is required; without one /api/ai returns
# 503 "AI tools are not configured".
# ---------------------------------------------------------------------------

# Groq — free tier, fastest. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides. Default model: llama-3.3-70b-versatile
GROQ_MODEL=
GROQ_BASE_URL=

# NVIDIA NIM / DeepSeek — used as automatic fallback when Groq is rate-limited.
NVIDIA_DEEPSEEK_API_KEY=
NVIDIA_DEEPSEEK_MODEL=

# Optional: pin which provider is tried first — groq | nvidia
AI_PROVIDER=

# Moonshot AI (Kimi models) — the PRIMARY OCR provider. Powers scanned-page OCR
# in the PDF→Word / summarizer / table tools. Get a key at
# https://platform.moonshot.ai. Defaults: base URL https://api.moonshot.ai/v1,
# model kimi-k3. Set MOONSHOT_VISION_MODEL to another available model (list them
# with GET /v1/models on your key) if you'd rather use e.g. kimi-k2.6. Point
# MOONSHOT_BASE_URL at https://api.kimi.com/coding/v1 if your key is from the
# older Kimi Coding console instead of the Moonshot platform.
# Without a key, OCR falls back to the local Unlimited-OCR server below (if running).
MOONSHOT_API_KEY=
MOONSHOT_VISION_MODEL=
MOONSHOT_BASE_URL=

# Mistral OCR — a purpose-built document-OCR API (native Markdown per page,
# not a vision-chat prompt). Available as a SELECTABLE provider for A/B
# testing against Kimi; it does NOT join the default auto chain on its own —
# reach it via OCR_PROVIDER=mistral or a per-request provider:"mistral".
# Get a key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=

# Optional: pin the OCR provider chain — kimi | local | mistral. Default "auto"
# tries Kimi first when MOONSHOT_API_KEY is set, then the local server. Mistral is
# excluded from "auto" until it's been A/B tested against Kimi on real
# documents — pin it explicitly to try it.
OCR_PROVIDER=

# Audio/video transcription (Video & Audio Studio). Reuses GROQ_API_KEY above.
# Default model: whisper-large-v3-turbo
GROQ_WHISPER_MODEL=
# Transcription requires working Upstash in production (fails closed otherwise).
# Per client: 3/minute, 15/day. Site-wide: 100 requests/day, including failures.
# This caps request count, not a monetary amount; also set a provider billing cap.
TRANSCRIBE_RATELIMIT_PER_MIN=
TRANSCRIBE_RATELIMIT_PER_DAY=
TRANSCRIBE_GLOBAL_PER_DAY=

# Local Unlimited-OCR server — now an OPTIONAL fallback behind Kimi, for
# self-hosters running the model. Defaults to http://127.0.0.1:10000 when unset.
UNLIMITED_OCR_SERVER_URL=
UNLIMITED_OCR_API_KEY=

# ---------------------------------------------------------------------------
# Rate limiting for /api/ai (OCR + chat). Protects the paid providers above
# from anonymous abuse. Upstash is shared across serverless instances and is the
# only backend that actually works on Vercel; without it the limiter falls back
# to per-instance in-memory counting (fine for self-host, weak on serverless).
# Create a free DB at https://console.upstash.com → REST API.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional limit overrides (defaults: OCR 60/min, 600/day; chat 20/min, 300/day).
OCR_RATELIMIT_PER_MIN=
OCR_RATELIMIT_PER_DAY=
AI_RATELIMIT_PER_MIN=
AI_RATELIMIT_PER_DAY=
# Adobe PDF Services — powers the optional "Adobe High Quality" engine on
# PDF → Word (/api/pdf/adobe-export). Optional: without these the engine is
# still selectable but returns a message telling the user it isn't configured,
# and the default in-browser engine is unaffected.
# Bills per document, so the rate limit below is intentionally tight (default
# 3/min, 15/day per client) — raise it if that's too strict for real traffic.
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=
ADOBE_RATELIMIT_PER_MIN=
ADOBE_RATELIMIT_PER_DAY=
