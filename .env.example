# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
NVIDIA_NEMOTRON_API_KEY=
NVIDIA_DEEPSEEK_API_KEY=
# Public REST API (/api/v1). Required to issue and verify API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every key already issued.
API_KEY_SECRET=
# Optional: comma-separated key ids (or full keys) to revoke.
API_KEY_REVOKED=
# Optional overrides (defaults: 60 requests/minute per key, 10 new keys/hour per IP).
API_RATE_LIMIT_PER_MINUTE=
API_KEY_ISSUE_LIMIT_PER_HOUR=
