# Server-only credentials. Never prefix these with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# AI productivity tools (PDF Summarizer, Code Explainer, Document Translator).
# At least ONE chat provider key is required; without one /api/ai returns
# 503 "AI tools are not configured".
# ---------------------------------------------------------------------------

# Groq — free tier, fastest. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides. Default model: llama-3.3-70b-versatile
GROQ_MODEL=
GROQ_BASE_URL=

# NVIDIA NIM / DeepSeek — used as automatic fallback when Groq is rate-limited.
NVIDIA_DEEPSEEK_API_KEY=
NVIDIA_DEEPSEEK_MODEL=

# Optional: pin which provider is tried first — groq | nvidia
AI_PROVIDER=

# Cloud AI (PDF → Excel table extraction, Pro feature). Kimi (Moonshot AI).
# Get a key at https://platform.kimi.ai — note the sk-kimi- prefix routes to
# api.kimi.com/coding/v1, not api.moonshot.ai.
KIMI_API_KEY=
KIMI_VISION_MODEL=
KIMI_BASE_URL=

# Audio/video transcription (Video & Audio Studio). Reuses GROQ_API_KEY above.
# Default model: whisper-large-v3-turbo
GROQ_WHISPER_MODEL=

# Local Unlimited-OCR server (Image OCR + scanned-page OCR in the summarizer).
# Defaults to http://127.0.0.1:10000 when unset. Start it with run_server.bat.
UNLIMITED_OCR_SERVER_URL=
UNLIMITED_OCR_API_KEY=
# ---------------------------------------------------------------------------
# Contact form (/api/contact). Relays the form over SMTP to CONTACT_TO_EMAIL.
# Without SMTP_HOST/SMTP_USER/SMTP_PASS the endpoint returns 503 and the form
# tells visitors to email directly instead.
#
# Use an app-specific password, never your main account password. Port 465
# uses implicit TLS; 587 (default) upgrades via STARTTLS.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where messages are delivered. Defaults to support@easytoconvert.in.
CONTACT_TO_EMAIL=
# Envelope sender. Must be an address your SMTP host is allowed to send as,
# otherwise SPF/DKIM will fail. Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=

# Adobe PDF Services
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# JOPDF local execution override (optional)
JOPDF_JAVA_EXE=
JOPDF_CLASSPATH=
JOPDF_SECRET=
