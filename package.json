    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.4.20",
    "ignore-loader": "^0.1.2",
    "jszip": "^3.10.1",
    "postcss": "8.5.15",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
