{
  "name": "easytoconvert",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-pdf-worker": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "predev": "npm run sync-pdf-worker",
    "prebuild": "npm run sync-pdf-worker",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@adobe/pdfservices-node-sdk": "^4.1.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^3.5.2",
    "@hyzyla/pdfium": "^2.1.13",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.453.0",
    "mammoth": "^1.12.1",
    "next": "15.5.20",
    "pdf-lib": "^1.17.1",
    "pdf-lib-plus-encrypt": "^1.1.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
